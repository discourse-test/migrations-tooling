#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../../../Gemfile", __dir__)

require "bundler"

# a standalone install (BUNDLE_ONLY=migrations, see README) has no gems from
# the default group; commands that boot Rails don't work there
if (only_groups = ENV["BUNDLE_ONLY"])
  Bundler.setup(*only_groups.split(/[\s:,]+/).map(&:to_sym))
else
  Bundler.setup(:default, :migrations)
end

require "colored2"

require "migrations-core"
require "migrations-tooling"
require "migrations-converters"
require "migrations-importer"

Migrations.enable_i18n
Migrations.apply_global_config

# Each gem registers its top-level commands into DiscourseDisco::CLI::Registry.
require "migrations/tooling/register"
require "migrations/converters/register"
require "migrations/importer/register"

if defined?(RubyVM::YJIT)
  RubyVM::YJIT.enable
else
  warn "WARNING: Performance degraded: RubyVM::YJIT is not available".yellow
end

Dir.chdir(Migrations.host_app_root) do
  DiscourseDisco::CLI::ExceptionHandler.handle_and_exit do
    DiscourseDisco::CLI::Bootstrap.run(
      ARGV,
      program_name: "bin/disco",
      description: "Discourse migration tools",
      boot_rails: -> { Migrations.load_rails_environment(quiet: true) },
    )
  end
end
