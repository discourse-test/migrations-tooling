# Local settings overrides (may hold credentials); the committed files next to
# them are the templates.
/gems/importer/config/upload.local.yml
/gems/converters/lib/migrations/converters/**/settings.local.yml

# Private converters live here and are never committed.
/private/

/.bundle/
/coverage/
/tmp/
/vendor/
.rspec_status
.ruby-version
/.idea/
/.silo.local.yml
