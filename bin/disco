#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../disco/environment"

discourse_root = MigrationsTooling.discourse_root

if discourse_root
  core_launcher = File.join(discourse_root, "script", "disco")
  exec(core_launcher, *ARGV) if File.exist?(core_launcher)

  # Booting Rails sets up core's bundle, which activates the plugin's gems.
  ENV["BUNDLE_GEMFILE"] = File.join(discourse_root, "Gemfile")
  ENV["DISCOURSE_DEV_ALLOW_HTTPS"] = "1" # suppress warning
  # Discourse resolves some paths relative to the working directory.
  Dir.chdir(discourse_root)
  require File.join(discourse_root, "config", "environment")
  boot_rails = -> {}
else
  ENV["BUNDLE_GEMFILE"] = File.join(MigrationsTooling::PLUGIN_ROOT, "Gemfile")
  require "bundler"
  Bundler.setup
  boot_rails = nil
end

require_relative "../disco/register"

if defined?(RubyVM::YJIT)
  RubyVM::YJIT.enable
else
  warn "WARNING: Performance degraded: RubyVM::YJIT is not available".yellow
end

DiscourseDisco::CLI::ExceptionHandler.handle_and_exit do
  DiscourseDisco::CLI::Bootstrap.run(
    ARGV,
    program_name: "bin/disco",
    description: "Discourse migration tools",
    boot_rails:,
  )
end
